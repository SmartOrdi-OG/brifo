ANTHROPIC_API_KEY=sk-ant-...

# Web push (appointment reminders that fire even when the app is closed).
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services may use to reach you about this app, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Storage for push subscriptions + scheduled reminders. Point these at a
# Vercel KV / Upstash Redis REST endpoint in production. Left empty, the
# server falls back to an in-memory store that only works for local dev
# (data is lost on every restart / serverless cold start).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret checked by /api/cron/send-reminders. Vercel sends it
# automatically as `Authorization: Bearer $CRON_SECRET` for its own Cron
# Jobs once this is set. On the Hobby plan (which only allows daily cron),
# an external pinger (e.g. cron-job.org) hitting
# /api/cron/send-reminders?secret=... every ~15 min is a viable substitute.
CRON_SECRET=

# Password checked by /api/admin/ratings (the in-app user-ratings viewer at
# /admin). Left empty, that route is open to anyone — set this in production.
ADMIN_SECRET=

# Supabase Auth (real user accounts — magic-link sign-in gates the whole app).
# Both values are the public "anon" pair from Project Settings → API and are
# safe to ship in the client bundle (must be VITE_-prefixed so Vite exposes
# them to the browser). Left empty, the app shows an "auth not configured"
# screen instead of the sign-in form.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe subscription billing (1.90 EUR/month, gated behind a 7-day trial —
# see lib/trial.ts). Use the *test mode* keys until ready to charge real
# customers. STRIPE_PRICE_ID is optional — leave empty and the server
# creates a Product/Price once on first checkout and caches its id in KV.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret for the Stripe CLI / Dashboard webhook endpoint pointed at
# /api/stripe-webhook (Developers → Webhooks → your endpoint → Signing secret).
# Required for subscription status to ever update — without it, checkouts
# complete on Stripe's side but the app never finds out.
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails that always count as subscribed, skipping the trial
# and paywall entirely — for the app owner's own accounts, not general use.
FREE_ACCOUNT_EMAILS=
